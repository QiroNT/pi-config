{
	"name": "pi-extension-gondolin",
	"private": true,
	"version": "0.82.1",
	"type": "module",
	"scripts": {
		"clean": "echo 'nothing to clean'",
		"build": "echo 'nothing to build'",
		"build:image": "docker build --file bin/Dockerfile --tag pi-gondolin-rootfs:latest . && gondolin build --config image.json --tag pi-gondolin:latest",
		"check": "node --experimental-strip-types --check index.ts"
	},
	"pi": {
		"extensions": [
			"./index.ts",
			"./node_modules/@howaboua/pi-codex-conversion/dist/index.js"
		]
	},
	"dependencies": {
		"@earendil-works/gondolin": "0.12.0",
		"@howaboua/pi-codex-conversion": "2.2.22"
	}
}
